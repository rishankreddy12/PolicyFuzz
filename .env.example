# PolicyFuzz configuration — see IMPLEMENTATION_PLAN.md §5.4

# Provider: scripted (replay fixtures), ollama (local LLM), or gemini (Google Gemini API)
POLICYFUZZ_PROVIDER=gemini

# Database path (SQLite)
POLICYFUZZ_DB=data/policyfuzz.db

# Run artifacts directory
POLICYFUZZ_RUNS_DIR=data/runs

# Gemini configuration (if POLICYFUZZ_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama host (live mode only)
OLLAMA_HOST=http://localhost:11434

# Interpreter models
POLICYFUZZ_MODEL_A=gemini-3.5-flash
POLICYFUZZ_MODEL_B=gemini-3.5-flash
POLICYFUZZ_MODEL_C=gemini-3.5-flash

# Strong model for parser/casegen/analyst/patcher
POLICYFUZZ_MODEL_STRONG=gemini-3.5-flash
